rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Exams Collection (Shared question bank across all devices)
    match /exams/{examId} {
      allow read: if true;
      allow create, update, delete: if isValidId(examId);
    }

    // Exam Attempts & Scores
    match /attempts/{attemptId} {
      allow read: if true;
      allow create, update, delete: if isValidId(attemptId);
    }
  }
}
